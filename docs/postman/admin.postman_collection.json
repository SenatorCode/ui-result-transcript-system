{
 "info": {"name": "Admin API (Dev C)", "description": "Run 1 (CSRF) then 2 (Login) first. Postman keeps the session cookie, and the scripts keep {{csrf_token}} up to date.", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
 "variable": [{"key": "base_url", "value": "http://localhost/ui-result-transcript-system/api"}, {"key": "admin_username", "value": "registry.admin"}, {"key": "admin_password", "value": "Admin@1234"}, {"key": "request_id", "value": "tr_1001"}, {"key": "csrf_token", "value": ""}],
 "item": [
  {"name": "1. CSRF token (run first)", "request": {"method": "GET", "header": [], "url": "{{base_url}}/admin/auth/csrf.php"}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["const j = pm.response.json();", "pm.test('Status is 200', () => pm.response.to.have.status(200));", "pm.test('Has a CSRF token', () => pm.expect(j.data.csrfToken).to.be.a('string'));", "pm.collectionVariables.set('csrf_token', j.data.csrfToken);"]}}]},
  {"name": "2. Login", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "X-CSRF-Token", "value": "{{csrf_token}}"}], "url": "{{base_url}}/admin/auth/login.php", "body": {"mode": "raw", "raw": "{\n  \"username\": \"{{admin_username}}\",\n  \"password\": \"{{admin_password}}\"\n}", "options": {"raw": {"language": "json"}}}}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["const j = pm.response.json();", "pm.test('Status is 200', () => pm.response.to.have.status(200));", "pm.test('Admin id looks like ad_', () => pm.expect(j.data.admin.id).to.match(/^ad_/));", "pm.collectionVariables.set('csrf_token', j.data.csrfToken);"]}}]},
  {"name": "3. Me", "request": {"method": "GET", "header": [], "url": "{{base_url}}/admin/auth/me.php"}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["const j = pm.response.json();", "pm.test('Status is 200', () => pm.response.to.have.status(200));", "pm.test('Has a CSRF token', () => pm.expect(j.data.csrfToken).to.be.a('string'));", "pm.collectionVariables.set('csrf_token', j.data.csrfToken);"]}}]},
  {"name": "4. Dashboard", "request": {"method": "GET", "header": [], "url": "{{base_url}}/admin/dashboard.php"}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["const j = pm.response.json();", "pm.test('Status is 200', () => pm.response.to.have.status(200));", "pm.test('All ten statuses present', () => pm.expect(Object.keys(j.data.requests.byStatus).length).to.eql(10));"]}}]},
  {"name": "5. Requests list", "request": {"method": "GET", "header": [], "url": "{{base_url}}/admin/transcripts/index.php"}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"]}}]},
  {"name": "5b. Requests list (filtered)", "request": {"method": "GET", "header": [], "url": "{{base_url}}/admin/transcripts/index.php?status=paid,processing&destinationType=personal&sort=newest&page=1&pageSize=20"}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"]}}]},
  {"name": "5c. Requests list (bad filters, expect 422)", "request": {"method": "GET", "header": [], "url": "{{base_url}}/admin/transcripts/index.php?status=bogus&q=a&pageSize=99"}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status is 422', () => pm.response.to.have.status(422));"]}}]},
  {"name": "6. Request detail", "request": {"method": "GET", "header": [], "url": "{{base_url}}/admin/transcripts/show.php?id={{request_id}}"}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["const j = pm.response.json();", "pm.test('Status is 200', () => pm.response.to.have.status(200));", "pm.test('Has transcript, student and payments', () => { pm.expect(j.data.transcript).to.exist; pm.expect(j.data.student).to.exist; pm.expect(j.data.payments).to.be.an('array'); });"]}}]},
  {"name": "7a. Update status: start_processing", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "X-CSRF-Token", "value": "{{csrf_token}}"}], "url": "{{base_url}}/admin/transcripts/update-status.php?id={{request_id}}", "body": {"mode": "raw", "raw": "{\n  \"action\": \"start_processing\"\n}", "options": {"raw": {"language": "json"}}}}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"]}}]},
  {"name": "7b. Update status: mark_ready (personal copy)", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "X-CSRF-Token", "value": "{{csrf_token}}"}], "url": "{{base_url}}/admin/transcripts/update-status.php?id={{request_id}}", "body": {"mode": "raw", "raw": "{\n  \"action\": \"mark_ready\"\n}", "options": {"raw": {"language": "json"}}}}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"]}}]},
  {"name": "7c. Update status: mark_sent (institution copy)", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "X-CSRF-Token", "value": "{{csrf_token}}"}], "url": "{{base_url}}/admin/transcripts/update-status.php?id={{request_id}}", "body": {"mode": "raw", "raw": "{\n  \"action\": \"mark_sent\"\n}", "options": {"raw": {"language": "json"}}}}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"]}}]},
  {"name": "7d. Update status: reject", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "X-CSRF-Token", "value": "{{csrf_token}}"}], "url": "{{base_url}}/admin/transcripts/update-status.php?id={{request_id}}", "body": {"mode": "raw", "raw": "{\n  \"action\": \"reject\",\n  \"reason\": \"Results are under review.\"\n}", "options": {"raw": {"language": "json"}}}}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"]}}]},
  {"name": "7e. Update status: reject with no reason (expect 422)", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "X-CSRF-Token", "value": "{{csrf_token}}"}], "url": "{{base_url}}/admin/transcripts/update-status.php?id={{request_id}}", "body": {"mode": "raw", "raw": "{\n  \"action\": \"reject\"\n}", "options": {"raw": {"language": "json"}}}}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status is 422', () => pm.response.to.have.status(422));"]}}]},
  {"name": "8. Payments list", "request": {"method": "GET", "header": [], "url": "{{base_url}}/admin/payments/index.php"}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"]}}]},
  {"name": "8b. Payments list (filtered)", "request": {"method": "GET", "header": [], "url": "{{base_url}}/admin/payments/index.php?status=success&gateway=simulated&from=2026-10-01&to=2026-10-31"}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"]}}]},
  {"name": "9. Download PDF", "request": {"method": "GET", "header": [], "url": "{{base_url}}/admin/transcripts/document.php?id={{request_id}}"}},
